# Copy to .env.local for development. Never commit .env.local.

# --- Database (Phase 03) ---------------------------------------------------
# Postgres connection string. Everything degrades gracefully without it:
#   POST /api/leads answers 503 so the client falls back to composing an email
#   POST /api/quiz  answers { ok: true, stored: false } and the page carries on
# There is one connection string — Postgres is local to the VPS, so no
# pooled/unpooled split (§6.1).
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/rem_assist

# --- Lead notification (§9.3) ----------------------------------------------
# Webhook that receives a plain-text summary on every lead. A Slack incoming
# webhook works as-is. Unset = notifications are skipped silently.
# LEAD_WEBHOOK_URL=

# --- Site (§11) ------------------------------------------------------------
# Origin used for canonicals, OG urls and the sitemap. Defaults to
# https://remassistance.com — set this on staging so its pages do not declare
# production canonicals.
# NEXT_PUBLIC_SITE_URL=https://staging.remassistance.com

# --- Analytics -------------------------------------------------------------
# Google Tag Manager container, e.g. GTM-XXXXXXX. Leave unset and no tag loads
# at all: components/analytics/GoogleTagManager.tsx renders null without it.
NEXT_PUBLIC_GTM_ID=
# The production gate. Events are only emitted when this is exactly
# 'production' (see lib/analytics/events.ts). Set it in the *Production scope
# only* in the Vercel dashboard, and in shared/.env on the VPS. Leave it unset
# locally and in CI: the site works, the banner works, nothing is measured.
#
# NEXT_PUBLIC_* is inlined at build time, not read at runtime. On the VPS that
# is fine only because deploy/remote-deploy.sh sources shared/.env before it
# runs `next build` — move the build anywhere else and this silently becomes
# undefined, with no error to tell you analytics has gone dark.
# NEXT_PUBLIC_ANALYTICS_ENV=production
# Consent gate. 'opt-in' (the default when unset) stores nothing — no
# attribution cookie, no tags — until the visitor accepts. Set to 'off' ONLY
# if this site does not serve EEA or UK visitors: it removes the banner and
# grants everything. That is a legal decision, not a performance one.
NEXT_PUBLIC_CONSENT_MODE=opt-in

# --- Admin authentication (Phase 04, §10) ----------------------------------
# Emailed sign-in links for internal editors. There are no passwords and no
# public accounts; access is limited to the domains in lib/auth/allowlist.ts.
#
# Signing secret. Generate with:  openssl rand -base64 32
# Without it Auth.js refuses to start, so /admin is unreachable rather than
# unprotected — which is the right way round for this to fail.
AUTH_SECRET=

# Canonical origin for the callback URL in the emailed link. Behind Nginx this
# must agree with the proxy: if X-Forwarded-Proto is not set, links come back
# as http:// and the sign-in fails after the click, not before it.
AUTH_URL=https://remassistance.com

# Resend API key that sends the sign-in email. Unset = nobody can sign in —
# except in local development, where the link and code are printed to the dev
# server terminal instead (see printLinkLocally in auth.ts).
AUTH_RESEND_KEY=

# From address. The domain here must be VERIFIED IN RESEND, and it must be a
# SUBDOMAIN — auth.remconnect.io, not remconnect.io.
#
# This is not a style preference. The apex MX/SPF/DKIM records for both company
# domains belong to Microsoft 365, and deploy/README.md is explicit that
# touching them breaks mail. Verifying a subdomain adds records only under that
# subdomain, so company mail flow cannot be affected by a sign-in misconfig.
AUTH_EMAIL_FROM=Rem Assist <signin@auth.remconnect.io>
